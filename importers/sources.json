    {
      "id": "easyui",
      "name": "Easy UI",
      "repo": "https://github.com/Surajmaurya1/easyui",
      "homepage": "https://easyui.pro",
      "parser": "shadcn-registry",
      "registry": "registry.json",
      "aliases": {
        "@/": "src/"
      },
      "framework": "react",
      "metadata": "src/components/registry/components-data.ts",
      "theme": {
        "file": [
          "src/styles/tokens.css",
          "src/styles/index.css"
        ],
        "name": "Easy UI"
      },
      "routeDemos": {
        "pattern": "src/components/docs/detail/demos/items/{name}.demo.tsx",
        "registries": [
          {
            "file": "src/components/docs/detail/demo-components.ts",
            "name": "DEMO_COMPONENTS"
          },
          {
            "file": "src/components/docs/detail/inline-demo-registry.tsx",
            "name": "INLINE_DEMO_COMPONENTS"
          }
        ],
        "reexports": {
          "src/components/docs/detail/demo-registry.ts": "export { DEMO_COMPONENTS } from './demo-components';\n"
        }
      }
    },
