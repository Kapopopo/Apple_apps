      ]
    },
    {
      "id": "cult-ui",
      "name": "Cult UI",
      "repo": "https://github.com/nolly-studio/cult-ui",
      "homepage": "https://www.cult-ui.com",
      "parser": "shadcn-built",
      "variants": [
        { "id": "cult-ui", "dir": "apps/www/public/r", "framework": "react", "aliases": { "@/": "" }, "fallbackSource": "shadcn", "theme": { "file": "apps/www/styles/globals.css", "name": "Cult UI" } }
      ]
    },
    {
      "id": "kokonut-ui",
      "name": "Kokonut UI",
      "repo": "https://github.com/kokonut-labs/kokonutui",
      "homepage": "https://kokonutui.com",
      "parser": "shadcn-built",
      "variants": [
        { "id": "kokonut-ui", "dir": "public/r", "framework": "react", "aliases": { "@/": "" }, "fallbackSource": "shadcn", "theme": { "file": "app/globals.css", "name": "Kokonut UI" } }
      ]
    },
    {
      "id": "reui",
      "name": "ReUI",
      "repo": "https://github.com/keenthemes/reui",
      "homepage": "https://reui.io",
      "parser": "shadcn-built",
      "variants": [
        { "id": "reui", "dir": "public/r/styles/base-luma", "framework": "react", "aliases": { "@/": "" }, "targetPaths": true, "fallbackSource": "shadcn", "theme": { "file": "styles/globals.css", "name": "ReUI" } }
      ]
    },
    {
      "id": "origin-ui",
      "name": "Origin UI",
      "repo": "https://github.com/cosscom/ui",
      "homepage": "https://coss.com/origin",
      "parser": "shadcn-built",
      "variants": [
        { "id": "origin-ui", "dir": "apps/origin/public/r", "framework": "react", "aliases": { "@/": "" }, "index": "apps/origin/registry.json", "nameFromTags": true, "fallbackSource": "shadcn", "theme": { "file": "apps/origin/app/globals.css", "name": "Origin UI" } }
      ]
    },
    {
      "id": "react-bits",
      "name": "React Bits",
      "repo": "https://github.com/DavidHDev/react-bits",
      "homepage": "https://reactbits.dev",
      "parser": "shadcn-built",
      "variants": [
        { "id": "react-bits", "dir": "public/r", "framework": "react", "variantSuffixes": ["-TS-TW", "-TS-CSS"] }
      ],
      "acceptRestricted": {
        "license": "LicenseRef-Commons-Clause",
        "attribution": "React Bits (https://reactbits.dev) : conserver la notice de copyright « Copyright (c) David Haz » et la licence MIT + Commons Clause dans le code copié.",
