      "id": "reui",
      "name": "ReUI",
      "repo": "https://github.com/keenthemes/reui",
      "homepage": "https://reui.io",
      "parser": "shadcn-built",
      "variants": [
        {
          "id": "reui",
          "dir": "public/r/styles/base-luma",
          "framework": "react",
          "aliases": {
            "@/registry/bases/base/ui/": "components/ui/",
            "@/registry/bases/base/lib/": "lib/",
            "@/registry/bases/base/hooks/": "hooks/",
            "@/registry-reui/bases/base/reui/": "components/reui/",
            "@/registry-reui/bases/base/hooks/": "hooks/",
            "@/": ""
          },
          "targetPaths": true,
          "fallbackSource": "shadcn",
          "theme": {
            "file": "styles/globals.css",
            "name": "ReUI"
          },
          "primitives": [
            {
              "dir": "registry/bases/base/ui",
              "target": "components/ui",
              "prefix": "@/registry/bases/base/ui/",
              "idPrefix": "ui-"
            },
            {
              "dir": "registry-reui/bases/base/hooks",
              "target": "hooks",
              "prefix": "@/registry-reui/bases/base/hooks/",
              "idPrefix": ""
            }
          ],
          "examples": {
            "meta": "registry-reui/_meta/components/bases/base",
            "root": "registry-reui/bases/base"
          }
        }
      ],
      "sparse": [
        "public/r/styles/base-luma",
        "styles",
        "registry/bases/base/ui",
        "registry-reui/_meta/components/bases/base",
        "registry-reui/bases/base",
        "components/ui/svgs"
      ]
    },
