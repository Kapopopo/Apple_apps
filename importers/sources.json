      }
    },
    {
      "id": "rare-ui",
      "name": "Rare UI",
      "repo": "https://github.com/swamimalode07/rare-ui",
      "homepage": "https://rareui.com",
      "parser": "shadcn-registry",
      "registry": "registry.json",
      "aliases": { "@/": "" },
      "framework": "react",
      "demos": "app/components/(docs)/*/demo.tsx",
      "theme": { "file": "app/globals.css", "name": "Rare UI" },
      "acceptRestricted": {
        "license": "LicenseRef-MIT-Commons-Clause-Attribution",
        "attribution": "Rare UI (https://rareui.com) : tout projet qui embarque un composant doit afficher un lien visible vers https://rareui.com (footer, page à propos, crédits ou README) et conserver la notice de copyright dans le code copié.",
        "notes": "MIT + Commons Clause + Attribution : usage libre dans tes projets, y compris commerciaux ; interdiction de vendre, sous-licencier ou redistribuer les composants eux-mêmes (seuls ou en pack). Accepté explicitement le 2026-11-05 pour un usage personnel dans un repo privé."
      }
    },
    {
      "id": "easyui",
      "name": "Easy UI",
      "repo": "https://github.com/Surajmaurya1/easyui",
      "homepage": "https://easyui.pro",
      "parser": "shadcn-registry",
      "registry": "registry.json",
      "aliases": { "@/": "src/" },
      "framework": "react",
      "metadata": "src/components/registry/components-data.ts",
      "theme": { "file": ["src/styles/tokens.css", "src/styles/index.css"], "name": "Easy UI" }
    },
    {
      "id": "panelui",
      "name": "PanelUI",
      "repo": "https://github.com/panel-ui/PanelUI",
      "homepage": "https://panelui.dev",
      "parser": "shadcn-built",
      "variants": [
        { "id": "panelui", "dir": "apps/docs/public/r", "framework": "react-native", "blockType": "screen", "aliases": { "@/": "" }, "componentList": { "file": "catalogue.json", "key": "componentModules" } },
        {
          "id": "panelui-web",
          "dir": "apps/docs/public/r/web",
          "framework": "react",
          "aliases": { "@/": "", "panelui-web/": "components/panelui/" },
          "demos": "apps/docs/components/web-demos/{name}/{overview,default,variants,basic}.tsx",
          "theme": { "file": "apps/docs/app/global.css", "name": "PanelUI Web" }
        }
      ]
    },
    {
      "id": "bencho",
      "name": "Bencho",
      "repo": "https://github.com/cabralorenzo/bencho",
      "homepage": "https://bencho.dev",
      "parser": "folder-blocks",
      "blocks": "blocks",
      "framework": "react",
      "exclude": ["assets", "playground", "sounds"],
      "excludeReadme": "\\b(Pro only|Bencho Pro|Premium)\\b",
      "theme": { "file": "tokens.css", "name": "Bencho" }
    }
  ]
}
