{
  "$comment": "Sources GitHub importées par `npm run import:github`. La licence est relue dans le LICENSE à chaque import : un changement en amont fait tomber l'acceptation et les items sont sautés (voir registry/_import-log.json).",
  "github": [
    {
      "id": "shadcn",
      "name": "shadcn/ui",
      "repo": "https://github.com/shadcn-ui/ui",
      "homepage": "https://ui.shadcn.com",
      "parser": "shadcn-built",
      "variants": [
        { "id": "shadcn", "dir": "apps/v4/public/r/styles/new-york", "framework": "react", "aliases": { "@/registry/new-york/": "", "@/": "" }, "theme": { "file": "apps/v4/app/globals.css", "name": "shadcn/ui" } }
      ]
    },
    {
      "id": "magic-ui",
      "name": "Magic UI",
      "repo": "https://github.com/magicuidesign/magicui",
      "homepage": "https://magicui.design",
      "parser": "shadcn-built",
      "variants": [
        { "id": "magic-ui", "dir": "apps/www/public/r", "framework": "react", "aliases": { "@/": "" }, "skipExisting": true, "fallbackSource": "shadcn", "theme": { "file": "apps/www/styles/globals.css", "name": "Magic UI" } }
      ]
    },
    {
      "id": "motion-primitives",
      "name": "Motion Primitives",
      "repo": "https://github.com/ibelick/motion-primitives",
