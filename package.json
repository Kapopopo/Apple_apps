{
  "name": "component-atlas-registry",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "description": "Registre local de composants, importers et serveur MCP de Component Atlas.",
  "scripts": {
    "start": "tsx server/index.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "import": "tsx importers/run.ts",
    "import:github": "tsx importers/run.ts github",
    "import:local": "tsx importers/run.ts local",
    "import:fontshare": "tsx importers/run.ts fontshare",
    "import:easings": "tsx importers/run.ts easings",
    "index": "tsx importers/run.ts index",
    "bundle": "tsx scripts/bundle.ts",
    "mcp": "tsx mcp/index.ts",
    "previews": "npm --prefix previews run build",
    "test": "node --import tsx --test tests/ts/*.test.ts",
    "update": "tsx importers/run.ts --update && npm run previews && npm run audit",
    "outdated": "tsx importers/run.ts outdated",
    "audit": "npm --prefix previews run audit --",
    "refresh": "npm run import && npm run previews && npm run audit",
    "schedule": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/schedule.ps1",
    "unschedule": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/unschedule.ps1",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "tsc -p tsconfig.json --noEmit && eslint . && prettier --check . && npm test",
    "test:e2e": "node --import tsx --test --test-concurrency=1 tests/e2e/*.test.ts",
    "setup": "npm ci --ignore-scripts && npm --prefix previews ci && npm --prefix demos ci --ignore-scripts && git config core.hooksPath .githooks",
    "enrich": "tsx scripts/enrich.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^1.7.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "eslint": "^10.14.0",
    "globals": "^16.5.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.2"
  }
}
